#include <stdio.h>
#include <string.h>

int main(void) {
    char s[] = "Brasilia";
    int  len = strlen(s);

    printf("Comprimento: %d\n", len);

    /* percorre e imprime cada char e seu codigo ASCII */
    for (int i = 0; i < len; i++)
        printf("s[%d] = '%c'  (ASCII %d)\n", i, s[i], s[i]);

    /* comparacao */
    char t[] = "Brasilia";
    printf("strcmp: %d\n", strcmp(s, t));  /* 0 = iguais */
    return 0;
}

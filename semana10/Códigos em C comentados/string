#include <stdio.h>
#include <string.h>

int main(void) {

    // Cria uma string com o texto "Brasilia".
    char s[] = "Brasilia";

    // Calcula o tamanho da string.
    int len = strlen(s);

    printf("Comprimento: %d\n", len);

    // Mostra cada caractere da string e seu código ASCII.
    for (int i = 0; i < len; i++)
        printf("s[%d] = '%c'  (ASCII %d)\n", i, s[i], s[i]);

    // Cria outra string para comparar.
    char t[] = "Brasilia";

    // Compara as duas strings.
    // Retorna 0 quando elas são iguais.
    printf("strcmp: %d\n", strcmp(s, t));

    return 0;
}
